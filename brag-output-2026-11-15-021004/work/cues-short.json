   "who": "coupon",
   "t0": 13.2,
   "t1": 14.3,
   "text": "Not on CouponDonation."
  },
  {
   "who": "coupon",
   "t0": 14.4,
   "t1": 16.5,
   "text": "Your donation becomes *gift cards for essentials*,"
  },
  {
   "who": "coupon",
   "t0": 16.6,
   "t1": 18.4,
   "text": "with a *receipt for every gift*."
  },
  {
   "who": "you",
   "t0": 18.9,
   "t1": 20.6,
   "text": "So it can't end up at a casino?"
  },
  {
   "who": "coupon",
   "t0": 20.8,
   "t1": 22.8,
   "text": "A grocery gift card can't buy a *BMW*."
  },
  {
   "who": "you",
   "t0": 23.3,
   "t1": 24.8,
   "text": "So I don't have to hope."
  },
  {
   "who": "coupon",
   "t0": 25,
   "t1": 25.9,
   "text": "You'll know."
  }
 ],
